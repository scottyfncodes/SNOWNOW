# SNOWNOW environment variables.
#
# There is exactly one safe default: copy nothing, set nothing, and the app
# runs entirely in demo mode. Every variable below opts into live mode or a
# piece of it — none is required. In live mode, a piece with nothing
# configured (or that fails) reports UNAVAILABLE, never demo data: the
# production build has no live-mode path that falls back to demo. See
# README.md → "Going live" and "Production data gate".

# ---------------------------------------------------------------------------
# Client (Vite) — baked into the static bundle at BUILD time, not read at
# runtime. Changing these means rebuilding, not just restarting a server.
# None of these are secrets: a base URL is not a credential.
# ---------------------------------------------------------------------------

# "demo" (default) or "live". Demo needs nothing else below.
VITE_DATA_MODE=demo

# Base URL to prefix onto traffic-proxy requests. Three real states, not two:
#   - Absent/commented out (the default below): no traffic backend at all —
#     live mode reports traffic UNAVAILABLE rather than a demo number. This
#     is what a plain `npm run dev` (Vite only, no API routes served) wants.
#   - Set to the empty string (VITE_API_BASE_URL=): same-origin — requests go
#     to this deployment's own relative /api/* paths. This is what
#     vercel.json sets for production, where api/*.mjs serverless functions
#     live in this same project. Only correct when something is actually
#     serving those routes at your origin (Vercel, or `vercel dev` locally) —
#     never set this locally against a plain `vite` dev server, which won't
#     have them and will just turn every traffic request into a 404.
#   - Set to an absolute URL: an external proxy — e.g.
#     http://localhost:8787 to develop against `npm run server`
#     (server/index.mjs) running in a second terminal.
# VITE_API_BASE_URL=http://localhost:8787

# CDOT/COtrip road conditions (src/providers/live/cotripRoad.ts). On by
# default in live mode — it fails safe (UNAVAILABLE) on any response it
# doesn't recognize, so there's no honesty cost to leaving it on. Set to
# "false" to disable outright.
VITE_ENABLE_ROAD_CONDITIONS=true

# ---------------------------------------------------------------------------
# Server (server/index.mjs) — a separate Node process, never bundled into the
# client, never sent to the browser. This is where the one real secret lives.
# ---------------------------------------------------------------------------

# Required for the traffic proxy to do anything. Without it every request
# gets an honest 503, which the client turns into "traffic unavailable" —
# never a fabricated drive time.
GOOGLE_ROUTES_API_KEY=

PORT=8787

# How long one (corridor, direction, date) travel curve is cached and shared
# across every request, not just re-fetched per page load.
TRAFFIC_CACHE_TTL_SECONDS=900

# Restrict this to your deployed frontend's origin in production; "*" is fine
# for local development only.
CORS_ORIGIN=*

# The dataset is Colorado-only today, so departure times are interpreted in
# this IANA zone. Change only if you add mountains outside it.
SNOWNOW_TIME_ZONE=America/Denver
